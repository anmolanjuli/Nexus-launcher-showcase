    <string name="frost_capture_notification">מצלם את הטפט לאפקט החלבי</string>
    <string name="frost_tab_explainer">הטפט הנוכחי מנוהל מחוץ ל-Nexus, ולכן הזכוכית החלבית צריכה לצלם אותו פעם אחת כדי לטשטש אותו מאחורי ווידג\'טים ותיקיות. Android יבקש ממך לאשר צילום מסך קצר — האפליקציה מסתירה קודם את הסמלים והווידג\'טים שלה, מצלמת פריים אחד ועוצרת מיד, כך שרק הטפט עצמו נשמר.</string>
    <string name="frost_tab_theme_color_warning">שכבת הרקע מוגדרת ל“צבע ערכת נושא” בהגדרות ערכת הנושא, מה שמחליף את הטפט בצבע אחיד בכל מקום — כולל האפקט החלבי. האפקט לא יציג את הטפט שצולם עד שתשנה זאת ל“טפט”.</string>
    <string name="frost_tab_switch_layer">העבר את שכבת הרקע לטפט</string>
    <string name="frost_tab_disabled_warning">זכוכית חלבית כבויה בהגדרות Nexus ← מראה — האפקט לא יופיע בשום מקום, כולל כאן, עד שתפעיל אותו מחדש.</string>
