<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intrinsic dimensions to force it to render as a properly proportioned pill -->
    <item
        android:width="250dp"
        android:height="48dp">
        <shape android:shape="rectangle">
            <!-- Same background as bg_nexus_search_widget -->
            <solid android:color="#40000000" />
            <corners android:radius="24dp" />
            <stroke android:width="0.5dp" android:color="#805A9EEA" />
        </shape>
    </item>

    <!-- The search icon -->
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center_vertical|start"
        android:start="16dp"
        android:drawable="@drawable/ic_search" />

</layer-list>
