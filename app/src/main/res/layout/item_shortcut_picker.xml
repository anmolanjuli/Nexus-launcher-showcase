<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/picker_icon_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:padding="12dp"
    android:background="@drawable/bg_picker_icon_unselected">

    <ImageView
        android:id="@+id/picker_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/picker_app_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/picker_app_icon"
        app:layout_constraintEnd_toStartOf="@+id/picker_shortcut_count"
        app:layout_constraintTop_toTopOf="@id/picker_app_icon"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_icon" />

    <TextView
        android:id="@+id/picker_shortcut_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_aurora_folder_card"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#7EB8D4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/check_indicator"
        app:layout_constraintTop_toTopOf="@id/picker_app_icon"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_icon" />

    <ImageView
        android:id="@+id/check_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/picker_app_icon"
        app:layout_constraintBottom_toBottomOf="@id/picker_app_icon" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_horizontal_shortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/picker_app_icon"
        app:layout_constraintBottom_toTopOf="@id/divider" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/picker_horizontal_shortcuts"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
