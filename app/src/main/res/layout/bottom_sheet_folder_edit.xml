<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_edit_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_folder_frosted_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_aurora_handle_pill" />

    <LinearLayout
        android:id="@+id/row_folder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">
        <EditText
            android:id="@+id/edit_folder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/folder_name_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textColorHint="@color/nexus_text_secondary"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/folder_edit_name_label"
            android:textColor="@color/nexus_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <include layout="@layout/folder_edit_preview_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/folder_edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp">

            <TextView style="@style/NexusFolderEditSection" android:text="@string/folder_edit_section_appearance" />
            <LinearLayout style="@style/NexusFolderEditSectionCard">
                <com.nexus.launcher.ui.folder.FolderShapeThumbnailRow
                    android:id="@+id/row_folder_shape_thumbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <com.nexus.launcher.ui.settings.views.NexusSegmentedRow
                    android:id="@+id/dropdown_folder_shape_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView style="@style/NexusFolderEditSection" android:text="@string/folder_edit_section_preview_style" />
            <LinearLayout style="@style/NexusFolderEditSectionCard">
                <com.nexus.launcher.ui.settings.views.NexusSegmentedRow
                    android:id="@+id/dropdown_folder_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/folder_edit_preview_style_desc"
                    android:textColor="@color/nexus_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout style="@style/NexusFolderEditSectionCard">
                <com.nexus.launcher.ui.settings.views.NexusToggleRow
                    android:id="@+id/switch_folder_expressive_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/header_folder_background"
                style="@style/NexusFolderEditSection"
                android:text="@string/folder_edit_section_background" />
            <LinearLayout
                android:id="@+id/card_folder_background"
                style="@style/NexusFolderEditSectionCard">
                <include layout="@layout/folder_edit_background_section" />
                <com.nexus.launcher.ui.settings.views.NexusToggleRow
                    android:id="@+id/switch_icon_match_folder_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView style="@style/NexusFolderEditSection" android:text="@string/folder_edit_section_layout" />
            <LinearLayout style="@style/NexusFolderEditSectionCard">
                <com.nexus.launcher.ui.settings.views.NexusSliderRow
                    android:id="@+id/slider_grid_columns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <com.nexus.launcher.ui.settings.views.NexusToggleRow
                    android:id="@+id/switch_show_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView style="@style/NexusFolderEditSection" android:text="@string/folder_edit_section_gestures" />
            <LinearLayout style="@style/NexusFolderEditSectionCard">
                <FrameLayout
                    android:id="@+id/folder_edit_gestures_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/folder_edit_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/btn_reset_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/action_reset"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_save_folder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_aurora_folder_card"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/action_apply"
            android:textColor="@color/nexus_mist_blue"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
