<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dock_settings_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_dock_settings_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dock_settings_title"
            android:textColor="@color/nexus_text_primary"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_dock"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/action_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apply_dock"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_apply" />
    </LinearLayout>

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_capacity_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_icon_size_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_height_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_corner_radius_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <include layout="@layout/dock_settings_background_section" />

    <com.nexus.launcher.ui.settings.views.NexusToggleRow
        android:id="@+id/dock_show_labels_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_label_font_size_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <com.nexus.launcher.ui.settings.views.NexusToggleRow
        android:id="@+id/dock_search_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/dock_settings_shuffle_motion_title"
        android:textColor="@color/nexus_text_primary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="1dp"
        android:text="@string/dock_settings_shuffle_motion_desc"
        android:textColor="@color/nexus_text_secondary"
        android:textSize="11sp" />

    <com.nexus.launcher.ui.settings.views.NexusSliderRow
        android:id="@+id/dock_shuffle_motion_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dock_settings_zigzag_layout"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dock_zigzag_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
