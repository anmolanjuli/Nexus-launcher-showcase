<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dock_settings_background"
            android:textColor="@color/nexus_text_primary"
            android:textSize="14sp" />

        <com.nexus.launcher.ui.settings.views.NexusSegmentedRow
            android:id="@+id/dock_background_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dock_background_children"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/dock_frosted_gradient_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/dock_frosted_gradient_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/dock_solid_color_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/dock_settings_color"
                android:textColor="@color/nexus_text_primary"
                android:textSize="14sp" />

            <View
                android:id="@+id/dock_solid_color_swatch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dock_settings_glass" />
        </LinearLayout>

        <com.nexus.launcher.ui.settings.views.NexusSliderRow
            android:id="@+id/dock_background_opacity_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>

</merge>
